#!/bin/sh
# Require one top-level CHANGELOG.md entry and one SemVer increment per PR.
# Individual commits within the branch are free (linters still run per commit).

read_stable_version() {
  git show "$1":package.json 2>/dev/null | node scripts/validate-semver-bump.mjs --read-package-version 2>/dev/null
}

MAIN_VERSION=$(read_stable_version origin/main || true)

while read -r local_ref local_sha remote_ref remote_sha; do
  # Skip deletions (local sha is all zeros) and pushes of main itself.
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  [ "$remote_ref" = "refs/heads/main" ] && continue

  BASE=$(git merge-base "$local_sha" origin/main 2>/dev/null) || continue

  if ! git diff --name-only "$BASE" "$local_sha" | grep -qx "CHANGELOG.md"; then
    echo ""
    echo "  pre-push: this branch adds no CHANGELOG.md entry."
    echo "  Add one top-level ## [x.y.z] section describing the PR and bump package.json once."
    echo ""
    exit 1
  fi

  PUSH_VERSION=$(read_stable_version "$local_sha" || true)
  VERSION_MIGRATION=false

  if [ -z "$PUSH_VERSION" ]; then
    echo ""
    echo "  pre-push: package.json must contain a stable x.y.z version."
    echo ""
    exit 1
  fi

  if [ "$MAIN_VERSION" = "0.3.252" ] && [ "$PUSH_VERSION" = "0.56.3" ]; then
    VERSION_MIGRATION=true
    if ! node scripts/validate-changelog-semver-history.mjs "$local_sha"; then
      echo ""
      echo "  pre-push: the 0.3.252 to 0.56.3 migration must match the inferred historical SemVer sequence."
      echo ""
      exit 1
    fi
  elif ! node scripts/validate-semver-bump.mjs "$MAIN_VERSION" "$PUSH_VERSION"; then
    echo ""
    echo "  pre-push: bump once per PR: patch (compatible fix), minor (compatible feature), major (breaking change)."
    echo ""
    exit 1
  fi

  FIRST_VERSION=$(git show "$local_sha:CHANGELOG.md" | sed -n 's/^## \[\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\)\].*/\1/p' | head -n 1)

  if [ "$VERSION_MIGRATION" = true ] && [ "$FIRST_VERSION" = "$PUSH_VERSION" ]; then
    continue
  fi

  if ! node scripts/validate-changelog-release-headings.mjs "$BASE" "$local_sha"; then
    echo ""
    echo "  pre-push: existing release headings must be retained. Insert the new release heading; do not rename one."
    echo ""
    exit 1
  fi

  ADDED_VERSIONS=$(git diff --unified=0 "$BASE" "$local_sha" -- CHANGELOG.md | sed -n 's/^+## \[\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\)\].*/\1/p')
  ADDED_COUNT=$(printf '%s\n' "$ADDED_VERSIONS" | sed '/^$/d' | wc -l | tr -d ' ')

  if [ "$ADDED_COUNT" -ne 1 ] || [ "$ADDED_VERSIONS" != "$PUSH_VERSION" ] || [ "$FIRST_VERSION" != "$PUSH_VERSION" ]; then
    echo ""
    echo "  pre-push: add exactly one new top-level CHANGELOG.md entry matching package.json version $PUSH_VERSION."
    echo ""
    exit 1
  fi
done

exit 0
